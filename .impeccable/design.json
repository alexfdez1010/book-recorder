  "narrative": {
    "northStar": "The Personal Reading Room",
    "overview": "The Personal Reading Room gives a private library a calm, spacious setting. Warm ivory supports white content surfaces, forest green identifies actions and selections, and real book covers give the collection its strongest visual detail. The language is editorial and approachable, with readable controls and visible actions.\n\nDepth belongs chiefly to books and overlays. Covers lift slightly under a fine pointer; dialogs settle into focus over a softened backdrop. These short responses follow an action. Content is present immediately, without a staged entrance or ambient loop. This description records the implemented system; the user delegated its visual language.",
    "keyCharacteristics": [
      "Ivory canvas, white panels and restrained forest green controls.",
      "Fraunces for reading identity; Geist for navigation, labels and data.",
      "Spacious grouping with visible actions and purposeful motion."
    ],
    "rules": [
      {
        "name": "The Shared Palette Rule",
        "body": "Charts reference the same CSS palette as the interface; do not establish a separate hardcoded chart theme.",
        "section": "colors"
      },
      {
        "name": "The Reading and Control Rule",
        "body": "Use serif type for page and book identity, and sans serif for navigation, form controls and data.",
        "section": "typography"
      },
      {
