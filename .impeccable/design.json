      "css": ".ds-nav{display:flex;min-height:48px;align-items:center;gap:12px;border-radius:12px;padding:12px 16px;background:var(--paper-soft,#eeefe8);color:var(--leather,#365b47);font-family:var(--font-sans,Geist,system-ui,sans-serif);font-size:14px;font-weight:500;text-decoration:none;transition:background-color 200ms var(--ease-library,cubic-bezier(.22,1,.36,1)),color 200ms var(--ease-library,cubic-bezier(.22,1,.36,1))}.ds-nav:hover{background:var(--paper-soft,#eeefe8);color:var(--leather,#365b47)}.ds-nav:focus-visible{outline:2px solid var(--leather,#365b47);outline-offset:4px;}.ds-nav-dot{margin-left:auto;width:6px;height:6px;border-radius:9999px;background:var(--leather,#365b47)}"
