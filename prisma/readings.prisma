model Reading {
  id         String   @id @default(cuid())
  bookId     String
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  finishedOn DateTime
  pages      Int
  language   String
  rating     Float?
  opinion    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([bookId, finishedOn, createdAt, id])
  @@index([finishedOn])
}
