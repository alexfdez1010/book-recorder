DATABASE_URL="postgresql://postgres:postgres@localhost:5434/book_recorder"
# Neon/Vercel: set DATABASE_URL_UNPOOLED to the direct (non-pooler) URL.
# Local PostgreSQL does not require this additional variable.
# DATABASE_URL_UNPOOLED="postgresql://user:password@direct-neon-host/db?sslmode=require"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_OWNER_EMAIL="your-email@example.com"
# SHA-256 of the random token in the private /setup#token=... link
AUTH_SETUP_TOKEN_HASH="replace-with-64-character-sha256-hash"
